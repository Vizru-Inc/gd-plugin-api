# Copy to .env (gitignored) and fill in. Read by server.mjs at startup.

# Ambient AI server (Socket.IO v2). Origin only; /ambient is added automatically.
AMBIENT_SERVER_URL=https://roverv2-fastapi.vizru-ras.com
# Subscription API Key from the integration guide. SECRET: never put it in panel/host code.
AMBIENT_SUBSCRIPTION_API_KEY=

# Offline testing: run `pnpm fake-ambient` and point at it instead:
# AMBIENT_SERVER_URL=http://localhost:4100
# AMBIENT_SUBSCRIPTION_API_KEY=fake
